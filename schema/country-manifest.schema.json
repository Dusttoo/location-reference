{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-reference.local/schema/country-manifest.schema.json",
  "title": "Country Manifest",
  "type": "object",
  "required": ["schemaVersion", "release", "countryCode", "totals", "list", "admin1"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "format": "date" },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "totals": {
      "type": "object",
      "required": ["records", "active", "deprecated", "merged"],
      "properties": {
        "records": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "deprecated": { "type": "integer", "minimum": 0 },
        "merged": { "type": "integer", "minimum": 0 },
        "censusPlaces": { "type": "integer", "minimum": 0 },
        "unmatchedGnisPopulatedPlaces": { "type": "integer", "minimum": 0 },
        "historicalGnisPopulatedPlaces": { "type": "integer", "minimum": 0 },
        "excludedGnisWithoutGeography": { "type": "integer", "minimum": 0 },
        "excludedDuplicateGnisRows": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "list": { "type": "string", "minLength": 1 },
    "admin1": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "fips": { "type": "string", "pattern": "^[0-9]{2}$" },
          "count": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^data/[a-z]{2}/admin1/[^/]+\\.jsonl$" }
        },
        "required": ["code", "name", "count", "file"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
