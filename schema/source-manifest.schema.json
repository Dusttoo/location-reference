{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-reference.local/schema/source-manifest.schema.json",
  "title": "Source Manifest",
  "type": "object",
  "required": ["release", "sources"],
  "properties": {
    "release": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "organization", "title", "publishedAt", "retrievedAt", "url", "file", "sha256", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "organization": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "publishedAt": { "type": "string", "format": "date" },
          "retrievedAt": { "type": "string", "format": "date" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "file": { "type": "string", "pattern": "^[^/]+\\.zip$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
