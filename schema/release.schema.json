{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-reference.local/schema/release.schema.json",
  "title": "Release Manifest",
  "type": "object",
  "required": ["schemaVersion", "release", "sources", "outputs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "format": "date" },
    "sources": { "$ref": "source-manifest.schema.json#/properties/sources" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
