{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-reference.local/schema/catalog.schema.json",
  "title": "Location Reference Catalog",
  "type": "object",
  "required": ["schemaVersion", "release", "updatedAt", "countries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "manifest", "localityCount", "activeLocalityCount"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 },
          "localityCount": { "type": "integer", "minimum": 0 },
          "activeLocalityCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
