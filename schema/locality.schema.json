{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-reference.local/schema/locality.schema.json",
  "title": "Canonical Locality",
  "type": "object",
  "required": ["id", "name", "slug", "countryCode", "admin1", "kind", "status", "searchTier", "coordinates", "sourceMappings"],
  "properties": {
    "id": { "type": "string", "pattern": "^loc_[a-z2-7]{26}$" },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "admin1": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "fips": { "type": "string", "pattern": "^[0-9]{2}$" }
      },
      "required": ["code", "name"],
      "additionalProperties": false
    },
    "admin2": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fips": { "type": "string", "pattern": "^[0-9]{3}$" }
      },
      "additionalProperties": false
    },
    "kind": { "enum": ["incorporated-place", "census-designated-place", "gnis-populated-place", "populated-place"] },
    "designation": { "type": "string", "minLength": 1 },
    "status": { "enum": ["active", "deprecated", "merged"] },
    "deprecatedAt": { "type": "string", "format": "date" },
    "mergedInto": { "type": "string", "pattern": "^loc_[a-z2-7]{26}$" },
    "searchTier": { "type": "integer", "minimum": 1, "maximum": 3 },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude", "source"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "source": { "enum": ["census", "gnis", "geonames"] }
      },
      "additionalProperties": false
    },
    "sourceMappings": {
      "type": "object",
      "properties": {
        "census": {
          "type": "object",
          "required": ["geoid", "ansiCode", "lsad", "functionalStatus"],
          "properties": {
            "geoid": { "type": "string", "pattern": "^[0-9]{7}$" },
            "ansiCode": { "type": "string", "pattern": "^[0-9]{8}$" },
            "lsad": { "type": "string", "minLength": 2, "maxLength": 2 },
            "functionalStatus": { "type": "string", "minLength": 1, "maxLength": 1 }
          },
          "additionalProperties": false
        },
        "gnis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["featureId"],
            "properties": {
              "featureId": { "type": "string", "pattern": "^[0-9]+$" },
              "censusCode": { "type": "string", "pattern": "^[0-9]{5}$" },
              "censusClassCode": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "geonames": {
          "type": "object",
          "required": ["geonameId"],
          "properties": { "geonameId": { "type": "string", "pattern": "^[0-9]+$" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    }
  },
  "additionalProperties": false
}
